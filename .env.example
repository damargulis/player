# Copy to .env.local (dev) or to the packaged data dir as .env
GENIUS_ACCESS_TOKEN=your-genius-api-access-token
# Needed for the DJ page (Claude picks what plays)
ANTHROPIC_API_KEY=sk-ant-your-key
# Needed for the concert tracker (JamBase Developer tier, data.jambase.com)
JAMBASE_API_KEY=your-jambase-api-key
# Offsite backup of library.json + DJ memories (regional GCS bucket, us-central1)
# The service account key goes at <data dir>/gcs-backup-key.json
GCS_BACKUP_BUCKET=your-bucket-name
